# Copy to .env and fill in. Never commit .env (it is gitignored), and never put
# a key on a command line: it shows in `ps`.

# OpenAI: question generation (bench/qa_gen.py, gpt-5-mini by default), a
# teacher pass run with an OpenAI model (prospector teach --teacher) and the OpenAI API
# arms. No model grades an answer.
OPENAI_API_KEY=

# Optional: another OpenAI-compatible endpoint. When set, every model is sent
# there on OPENAI_API_KEY.
# OPENAI_BASE_URL=

# OpenRouter: the teacher pass (gemini-3.7-flash) and every non-OpenAI API arm.
# The client sends a vendor-prefixed model id (google/..., anthropic/...)
# there on this key and refuses an OpenAI model aimed at it
# (src/graph_reasoner/llm/providers.py).
# OPENROUTER_PROVIDER=<host> pins the serving host, for a model that behaves
# differently by host.
OPENROUTER_API_KEY=

